import {get, orderByChild, query, ref} from "firebase/database"
import {db} from "../firebase.jsx";
import {removeCase} from "../utils/removeCase.jsx";

export const createCase = (newCase) => push(ref(db, "posts"), newCase).then(({key}) => key)

export const readCase = (searchPhrase = "", isAlphabetSorting = false) => {
    const casesDbRef = ref(db, "posts")
    const orderingField = isAlphabetSorting ? "title" : "id"

    return get(query(casesDbRef), orderByChild(orderingField)).then((snapshot) => {
        let loadedCases = []

        snapshot.forEach((caseSnapshot) => {
            const id = caseSnapshot.key
            const {title, completed} = caseSnapshot.val()
            loadedCases.push({id, title, completed})
        })

        if (searchPhrase !== "") {
            loadedCases = loadedCases.filter(({title}) =>
                title.toLowerCase().indexOf(searchPhrase.toLowerCase()) >= 0)
        }
        return isAlphabetSorting ? loadedCases : loadedCases.reverse()
    })
}

export const updateCase = (updCase) => set(ref(db, `posts/${updCase.id}`), updCase)

export const deleteCase = (CaseId) => remove(ref(db, `posts/${CaseId}`))


